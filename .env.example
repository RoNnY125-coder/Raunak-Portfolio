# ── Supabase (optional, kept for reference) ─────────────────────────────────
# VITE_SUPABASE_URL=your_supabase_project_url
# VITE_SUPABASE_ANON_KEY=your_supabase_anon_key

# ── GitHub API proxy (optional, avoids rate limits) ──────────────────────────
# GITHUB_TOKEN=your_github_personal_access_token

# ── Google AI (Gemini 2.0 Flash) ─────────────────────────────────────────────
# Get from: https://aistudio.google.com/app/apikey
# Safe to expose client-side (AI Studio key, scoped to generative AI only)
VITE_GEMINI_API_KEY=AIza...

# ── Resend (email delivery) ───────────────────────────────────────────────────
# Get from: https://resend.com → API Keys
# ⚠ SERVER-SIDE ONLY — set this in Vercel Dashboard → Settings → Environment Variables
# Never prefix with VITE_ or it will leak into the browser bundle
RESEND_API_KEY=re_...
